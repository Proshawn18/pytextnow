# TextNow Configuration Template
# Copy this file to .env and fill in your details:
#   cp .env.example .env

# Your TextNow username
TEXTNOW_USERNAME=your_username_here

# Your active connect.sid cookie value from browser DevTools:
# Inspect element (F12) -> Application / Storage -> Cookies -> https://www.textnow.com -> connect.sid
TEXTNOW_SID_COOKIE=s%3Ayour_connect_sid_cookie_here

# (Optional) Recipient phone number for testing / examples (E.164 format: +1XXXXXXXXXX)
TEXTNOW_RECIPIENT_PHONE=+15551234567

# (Optional) User-Agent matching your browser
TEXTNOW_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
